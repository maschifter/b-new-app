{
  "name": "@bnewapp/source",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "server:dev": "pnpm --filter @bnewapp/server dev",
    "mobile": "pnpm --filter @bnewapp/mobile start"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "turbo": "^2.5.3",
    "typescript": "~5.7.3"
  },
  "pnpm": {
    "overrides": { "react": "19.1.0", "react-dom": "19.1.0" },
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
