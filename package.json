{
  "name": "@bnewapp/source",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": ">=20.19.4" },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "server:dev": "pnpm --filter @bnewapp/server dev",
    "admin": "pnpm --filter @bnewapp/admin dev",
    "admin:build": "pnpm --filter @bnewapp/admin build",
    "mobile": "pnpm --filter @bnewapp/mobile start",
    "mobile:fresh": "pnpm --filter @bnewapp/mobile start:fresh",
    "mobile:clear-cache": "pnpm --filter @bnewapp/mobile clear-cache",
    "mobile:ios": "pnpm --filter @bnewapp/mobile ios",
    "mobile:ios:device": "pnpm --filter @bnewapp/mobile ios:device",
    "mobile:ios:device:release": "pnpm --filter @bnewapp/mobile ios:device:release",
    "mobile:android": "pnpm --filter @bnewapp/mobile android",
    "mobile:android:device": "pnpm --filter @bnewapp/mobile android:device",
    "mobile:android:device:release": "pnpm --filter @bnewapp/mobile android:device:release",
    "mobile:prebuild": "pnpm --filter @bnewapp/mobile prebuild",
    "mobile:prebuild:staging": "pnpm --filter @bnewapp/mobile prebuild:staging",
    "mobile:prebuild:production": "pnpm --filter @bnewapp/mobile prebuild:production",
    "edu": "pnpm --filter @bnewapp/edu start",
    "edu:fresh": "pnpm --filter @bnewapp/edu start:fresh",
    "edu:clear-cache": "pnpm --filter @bnewapp/edu clear-cache",
    "edu:ios": "pnpm --filter @bnewapp/edu ios",
    "edu:ios:device": "pnpm --filter @bnewapp/edu ios:device",
    "edu:android": "pnpm --filter @bnewapp/edu android",
    "edu:android:device": "pnpm --filter @bnewapp/edu android:device",
    "edu:prebuild": "pnpm --filter @bnewapp/edu prebuild",
    "edu:prebuild:staging": "pnpm --filter @bnewapp/edu prebuild:staging",
    "edu:prebuild:production": "pnpm --filter @bnewapp/edu prebuild:production",
    "db:new": "npx supabase migration new",
    "db:push": "npx supabase db push",
    "db:types": "npx supabase gen types typescript --linked > packages/types/src/database.generated.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7",
    "turbo": "^2.5.3",
    "typescript": "~5.7.3"
  },
  "pnpm": {
    "overrides": { "react": "19.2.0", "react-dom": "19.2.0" },
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@ffprobe-installer/darwin-arm64",
      "@ffprobe-installer/darwin-x64",
      "@ffprobe-installer/linux-x64",
      "esbuild",
      "ffmpeg-static"
    ],
    "patchedDependencies": {
      "expo-video@55.0.21": "patches/expo-video@55.0.21.patch"
    }
  }
}
