{
  "name": "@bnewapp/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @bnewapp/types build && tsc -b && vite build",
    "preview": "vite preview",
    "start": "serve -s dist -l ${PORT:-8080} --no-clipboard",
