    "typecheck": "pnpm --filter @bnewapp/types build && tsc -b"
  },
  "dependencies": {
    "@bnewapp/types": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@supabase/supabase-js": "2.102.1",
    "ra-data-simple-rest": "^5.4.0",
    "react": "19.2.0",
    "react-admin": "^5.4.0",
    "react-dom": "19.2.0",
    "react-router-dom": "^7.0.0",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.6"
  }
}
