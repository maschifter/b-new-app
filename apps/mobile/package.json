{
  "name": "@bnewapp/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "start:fresh": "expo start --clear",
    "clear-cache": "expo start --clear",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:device:release": "expo run:ios --device --configuration Release",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "android:device:release": "expo run:android --device --variant release",
    "prebuild": "cross-env EAS_BUILD_PROFILE=staging expo prebuild --clean",
    "prebuild:staging": "cross-env EAS_BUILD_PROFILE=staging expo prebuild --clean",
    "prebuild:production": "cross-env EAS_BUILD_PROFILE=production expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@bnewapp/dance-core": "workspace:*",
    "@bnewapp/dance-flow": "workspace:*",
    "@bnewapp/mobile-kit": "workspace:*",
    "@bnewapp/studio-core": "workspace:*",
    "@bnewapp/types": "workspace:*",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@supabase/supabase-js": "2.102.1",
    "@tanstack/react-query": "^5.74.4",
    "expo": "55.0.28",
    "expo-audio": "~55.0.18",
    "expo-blur": "~55.0.18",
    "expo-constants": "55.0.17",
    "expo-dev-client": "~55.0.38",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.16",
    "expo-router": "55.0.17",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "55.0.6",
    "expo-video": "~55.0.21",
    "jotai": "^2.20.2",
    "jotai-family": "^1.1.0",
    "jotai-tanstack-query": "^0.11.0",
    "nativewind": "^4.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-mmkv": "^3.3.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "cross-env": "^10.1.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.20",
    "react-test-renderer": "19.2.0",
    "tailwindcss": "~3.4.19",
    "typescript": "~5.9.2"
  }
}
