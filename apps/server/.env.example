# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
ALLOWED_ORIGINS=
RATE_LIMIT_MAX=120

# Supabase server credentials. Never expose this key to a client application.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Development-only secret protecting /dev/create-user and /dev/grant-admin (minimum 32 characters).
DEV_ADMIN_SECRET=replace-with-a-long-random-secret
