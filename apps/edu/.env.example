# Local development (loaded by `expo start`).
# Copy to .env and fill in real values. Every EXPO_PUBLIC_ value is embedded
# in the app bundle, so never put secrets here.
#
# EAS sets EAS_BUILD_PROFILE for development/staging/production builds. Keep
# environment-specific public values in EAS environment variables when EAS is added.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional API override. Leave it unset in local development: the app derives
# the host from Metro, so physical devices follow the current LAN IP
# automatically. Set it for a shared, tunnelled, or production backend.
# Android emulator loopback URLs use 10.0.2.2; real devices keep explicit URLs.
# For USB localhost access on Android, run: adb reverse tcp:3000 tcp:3000
# EXPO_PUBLIC_API_URL=https://api.example.com
