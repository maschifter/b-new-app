    "./result-screen": {
      "react-native": "./src/ui/dance-result-screen.tsx",
      "types": "./src/ui/dance-result-screen.tsx",
      "default": "./src/ui/dance-result-screen.tsx"
    },
    "./score-polling": {
      "react-native": "./src/score-polling.ts",
